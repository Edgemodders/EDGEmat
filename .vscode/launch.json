{
  // F5 runs EDGEmat in an extension development host. Build first: npm run build.
  // The host sometimes aborts at startup (exit code 134), only under the debugger: see
  // docs/dev-setup.md, "When F5's host crashes". Ctrl+F5 (Run Without Debugging) starts it without
  // the debugger. "trace" writes each session's debugger log (the crash's message among it) to
  // VS Code's logs folder, under the F5 window's exthost\ms-vscode.js-debug.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run EDGEmat",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/extensions/edgemat"],
      "outFiles": ["${workspaceFolder}/extensions/edgemat/dist/**/*.js"],
      "debugWebWorkerHost": false,
      "autoAttachChildProcesses": false,
      "trace": true
    },
    {
      // REDcode's main branch beside EDGEmat, until a REDcode release has its shared key store (Keys,
      // 0.10.16; EDGEmat #18). Build REDcode first: git pull, then npm run build in ../REDcode/extensions/redcode.
      "name": "Run EDGEmat with REDcode main",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/extensions/edgemat",
        "--extensionDevelopmentPath=${workspaceFolder}/../REDcode/extensions/redcode"
      ],
      "outFiles": ["${workspaceFolder}/extensions/edgemat/dist/**/*.js", "${workspaceFolder}/../REDcode/extensions/redcode/dist/**/*.js"],
      "debugWebWorkerHost": false,
      "autoAttachChildProcesses": false,
      "trace": true
    }
  ]
}
