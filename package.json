{
  "name": "edgemat-workspace",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "extensions/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "smoke": "npm run smoke --workspace extensions/edgemat",
    "tiling-check": "npm run tiling-check --workspace extensions/edgemat --",
    "edgemat:package": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && cd extensions/edgemat && vsce package --no-dependencies --out ../../dist/",
    "mcp:build": "npm run build --workspace packages/edgemat-mcp",
    "mcp:start": "node packages/edgemat-mcp/dist/server.cjs",
    "release:notes": "node tools/release/notes.mjs",
    "release:nexus": "node tools/release/nexus-zip.mjs"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0",
    "ovsx": "^1.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
