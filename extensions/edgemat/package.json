{
  "name": "edgemat",
  "displayName": "EDGEmat",
  "description": "The EDGE material editor for Cyberpunk 2077: find a garment's materials by its name, recolor its layers, make new materials from your words, and save them into your mod.",
  "publisher": "edgemodders",
  "version": "0.3.1",
  "license": "MIT",
  "preview": true,
  "galleryBanner": {
    "color": "#08090d",
    "theme": "dark"
  },
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Edgemodders/EDGEmat.git",
    "directory": "extensions/edgemat"
  },
  "homepage": "https://edgemodders.github.io/EDGEmat/",
  "bugs": {
    "url": "https://github.com/Edgemodders/EDGEmat/issues"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "cyberpunk",
    "cyberpunk2077",
    "modding",
    "materials",
    "mlsetup",
    "wolvenkit"
  ],
  "engines": {
    "vscode": "^1.70.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:edgemat.library",
    "onView:edgemat.desk",
    "onCommand:edgemat.deskToProject",
    "onCommand:edgemat.rebuildLibrary",
    "onCommand:edgemat.setGameFolder",
    "onCommand:edgemat.searchLibrary",
    "onCommand:edgemat.openSetup",
    "onCommand:edgemat.find",
    "onView:edgemat.find",
    "onCustomEditor:edgemat.setup",
    "onFileSystem:edgemat-game",
    "onCommand:edgemat.saveToProject",
    "onCommand:edgemat.newMaterial",
    "onCommand:edgemat.setImageKey",
    "onCommand:edgemat.clearImageKey",
    "onCommand:edgemat.connectAssistant",
    "onCommand:edgemat.openMaterial",
    "onCommand:edgemat.openMesh"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "edgemat",
          "title": "EDGEmat",
          "icon": "images/activity.svg"
        }
      ]
    },
    "views": {
      "edgemat": [
        {
          "id": "edgemat.desk",
          "name": "Desk"
        },
        {
          "id": "edgemat.library",
          "name": "Library"
        },
        {
          "id": "edgemat.find",
          "name": "Find"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "edgemat.desk",
        "contents": "The Desk holds the meshes and setups you are working on before they go into a project, and keeps them across restarts.\nRight-click a mesh in REDcode's Game Assets or Project view and pick Open in EDGEmat: it lands here with its looks and materials. A setup you open from here saves on the Desk; + on a line puts that one into a project, + in the title bar the whole Desk. Open the same mesh again after editing it to start a new variation."
      },
      {
        "view": "edgemat.find",
        "contents": "Find a garment by its in-game name, such as punk jeans or Sunny Ammo, or a mesh by part of its path. Then open its materials: each multilayered one opens in the setup editor with its own mask set.\n[Find...](command:edgemat.find)"
      },
      {
        "view": "edgemat.library",
        "contents": "EDGEmat needs your Cyberpunk 2077 folder to build its material library from your game.\n[Set Game Folder](command:edgemat.setGameFolder)",
        "when": "edgemat.state == noGame"
      },
      {
        "view": "edgemat.library",
        "contents": "EDGEmat reads the game through REDbridge, which was not found. Install REDcode and run its \"Install REDbridge\" command, or set edgemat.bridgePath to REDbridge.exe.\n[Open Settings](command:workbench.action.openSettings?%22edgemat.bridgePath%22)\n[Show Log](command:edgemat.showLog)",
        "when": "edgemat.state == noBridge"
      },
      {
        "view": "edgemat.library",
        "contents": "Building the material library from your game: every surface with its colors, and every microblend, with thumbnails. This runs once, and again after a game update.",
        "when": "edgemat.state == building"
      },
      {
        "view": "edgemat.library",
        "contents": "The library could not be built.\n[Show Log](command:edgemat.showLog)\n[Try Again](command:edgemat.rebuildLibrary)",
        "when": "edgemat.state == error"
      },
      {
        "view": "edgemat.library",
        "contents": "Nothing in the library matches your search.\n[Clear Search](command:edgemat.clearSearch)",
        "when": "edgemat.state == ready && edgemat.filtered"
      }
    ],
    "customEditors": [
      {
        "viewType": "edgemat.setup",
        "displayName": "EDGEmat Setup Editor",
        "selector": [
          {
            "filenamePattern": "*.mlsetup"
          },
          {
            "filenamePattern": "*.mlsetup.json"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "edgemat.find",
        "title": "Find...",
        "category": "EDGEmat",
        "icon": "$(search)"
      },
      {
        "command": "edgemat.clearFind",
        "title": "Clear Find",
        "category": "EDGEmat",
        "icon": "$(clear-all)"
      },
      {
        "command": "edgemat.openFoundSetup",
        "title": "Open Setup",
        "category": "EDGEmat"
      },
      {
        "command": "edgemat.openSetup",
        "title": "Open Setup...",
        "category": "EDGEmat",
        "icon": "$(go-to-file)"
      },
      {
        "command": "edgemat.searchLibrary",
        "title": "Search Library",
        "category": "EDGEmat",
        "icon": "$(search)"
      },
      {
        "command": "edgemat.clearSearch",
        "title": "Clear Search",
        "category": "EDGEmat",
        "icon": "$(clear-all)"
      },
      {
        "command": "edgemat.rebuildLibrary",
        "title": "Rebuild Library",
        "category": "EDGEmat",
        "icon": "$(refresh)"
      },
      {
        "command": "edgemat.setGameFolder",
        "title": "Set Game Folder",
        "category": "EDGEmat",
        "icon": "$(folder-opened)"
      },
      {
        "command": "edgemat.showLog",
        "title": "Show Log",
        "category": "EDGEmat",
        "icon": "$(output)"
      },
      {
        "command": "edgemat.openItem",
        "title": "Open",
        "category": "EDGEmat"
      },
      {
        "command": "edgemat.copyGamePath",
        "title": "Copy Game Path",
        "category": "EDGEmat",
        "icon": "$(copy)"
      },
      {
        "command": "edgemat.addToDesk",
        "title": "Add to Desk",
        "category": "EDGEmat",
        "icon": "$(layers)"
      },
      {
        "command": "edgemat.copyCetCommand",
        "title": "Copy CET Command",
        "category": "EDGEmat",
        "icon": "$(terminal)"
      },
      {
        "command": "edgemat.viewIn3D",
        "title": "View in 3D",
        "category": "EDGEmat",
        "icon": "$(eye)"
      },
      {
        "command": "edgemat.saveToProject",
        "title": "Save to Project...",
        "category": "EDGEmat",
        "icon": "$(save-as)"
      },
      {
        "command": "edgemat.newMaterial",
        "title": "New Material...",
        "category": "EDGEmat",
        "icon": "$(sparkle)"
      },
      {
        "command": "edgemat.newMaterialHere",
        "title": "New Material Here...",
        "category": "EDGEmat",
        "icon": "$(sparkle)"
      },
      {
        "command": "edgemat.setImageKey",
        "title": "Set Image Service Key...",
        "category": "EDGEmat"
      },
      {
        "command": "edgemat.clearImageKey",
        "title": "Clear Image Service Key...",
        "category": "EDGEmat"
      },
      {
        "command": "edgemat.connectAssistant",
        "title": "Connect an Assistant (MCP)...",
        "category": "EDGEmat",
        "icon": "$(plug)"
      },
      {
        "command": "edgemat.openMaterial",
        "title": "Open Material in EDGEmat...",
        "category": "EDGEmat",
        "icon": "$(symbol-color)"
      },
      {
        "command": "edgemat.openMesh",
        "title": "Open in EDGEmat",
        "category": "EDGEmat",
        "icon": "$(symbol-color)"
      },
      {
        "command": "edgemat.deskToProject",
        "title": "Add the Desk to Project...",
        "category": "EDGEmat",
        "icon": "$(add)"
      },
      {
        "command": "edgemat.clearDesk",
        "title": "Clear the Desk...",
        "category": "EDGEmat",
        "icon": "$(clear-all)"
      },
      {
        "command": "edgemat.removeFromDesk",
        "title": "Take Off the Desk",
        "category": "EDGEmat",
        "icon": "$(close)"
      },
      {
        "command": "edgemat.deskEntryToProject",
        "title": "Add to Project...",
        "category": "EDGEmat",
        "icon": "$(add)"
      },
      {
        "command": "edgemat.renameDeskEntry",
        "title": "Rename...",
        "category": "EDGEmat"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "edgemat.deskToProject",
          "when": "view == edgemat.desk",
          "group": "navigation@1"
        },
        {
          "command": "edgemat.clearDesk",
          "when": "view == edgemat.desk && !edgemat.deskEmpty",
          "group": "navigation@2"
        },
        {
          "command": "edgemat.newMaterial",
          "when": "view == edgemat.library",
          "group": "navigation@0"
        },
        {
          "command": "edgemat.find",
          "when": "view == edgemat.find",
          "group": "navigation@1"
        },
        {
          "command": "edgemat.clearFind",
          "when": "view == edgemat.find && edgemat.findActive",
          "group": "navigation@2"
        },
        {
          "command": "edgemat.openSetup",
          "when": "view == edgemat.library",
          "group": "navigation@0"
        },
        {
          "command": "edgemat.searchLibrary",
          "when": "view == edgemat.library",
          "group": "navigation@1"
        },
        {
          "command": "edgemat.clearSearch",
          "when": "view == edgemat.library && edgemat.filtered",
          "group": "navigation@2"
        },
        {
          "command": "edgemat.rebuildLibrary",
          "when": "view == edgemat.library",
          "group": "navigation@3"
        },
        {
          "command": "edgemat.setGameFolder",
          "when": "view == edgemat.library",
          "group": "more@1"
        },
        {
          "command": "edgemat.showLog",
          "when": "view == edgemat.library",
          "group": "more@2"
        },
        {
          "command": "edgemat.connectAssistant",
          "when": "view == edgemat.library",
          "group": "more@3"
        }
      ],
      "view/item/context": [
        {
          "command": "edgemat.openMesh",
          "when": "view == redcode.assets && viewItem =~ /^assetFile(\\.(model|mesh|mlsetup|mltemplate))?$/",
          "group": "2_open@8"
        },
        {
          "command": "edgemat.openMesh",
          "when": "view == redcode.project && viewItem =~ /^projectFile\\.model/",
          "group": "2_open@8"
        },
        {
          "command": "edgemat.openMaterial",
          "when": "view == redcode.project && viewItem =~ /^projectFile\\.mlsetup/",
          "group": "navigation@1"
        },
        {
          "command": "edgemat.viewIn3D",
          "when": "view =~ /^edgemat\\.(find|desk)$/ && viewItem =~ /^edgemat\\.mesh/",
          "group": "inline"
        },
        {
          "command": "edgemat.viewIn3D",
          "when": "view =~ /^edgemat\\.(find|desk)$/ && viewItem =~ /^edgemat\\.mesh/",
          "group": "view@1"
        },
        {
          "command": "edgemat.copyGamePath",
          "when": "view =~ /^edgemat\\.(library|find|desk)$/ && viewItem =~ /^edgemat\\.(gamePath|mesh)( |$)/",
          "group": "inline"
        },
        {
          "command": "edgemat.copyGamePath",
          "when": "view =~ /^edgemat\\.(library|find|desk)$/ && viewItem =~ /^edgemat\\.(gamePath|mesh)( |$)/",
          "group": "copy@1"
        },
        {
          "command": "edgemat.copyCetCommand",
          "when": "view =~ /^edgemat\\.(find|desk)$/ && viewItem =~ /edgemat\\.(mesh|item|material)/",
          "group": "copy@2"
        },
        {
          "command": "edgemat.addToDesk",
          "when": "view == edgemat.find && viewItem =~ /^edgemat\\.mesh/",
          "group": "view@0"
        },
        {
          "command": "edgemat.newMaterialHere",
          "when": "view =~ /^edgemat\\.(find|desk)$/ && viewItem =~ /edgemat\\.material$/",
          "group": "inline"
        },
        {
          "command": "edgemat.newMaterialHere",
          "when": "view =~ /^edgemat\\.(find|desk)$/ && viewItem =~ /edgemat\\.material$/",
          "group": "make@1"
        },
        {
          "command": "edgemat.deskEntryToProject",
          "when": "view == edgemat.desk && viewItem =~ /edgemat\\.deskEntry/",
          "group": "inline@8"
        },
        {
          "command": "edgemat.removeFromDesk",
          "when": "view == edgemat.desk && viewItem =~ /edgemat\\.deskEntry/",
          "group": "inline@9"
        },
        {
          "command": "edgemat.deskEntryToProject",
          "when": "view == edgemat.desk && viewItem =~ /edgemat\\.deskEntry/",
          "group": "desk@1"
        },
        {
          "command": "edgemat.renameDeskEntry",
          "when": "view == edgemat.desk && viewItem =~ /edgemat\\.deskEntry/",
          "group": "desk@2"
        },
        {
          "command": "edgemat.removeFromDesk",
          "when": "view == edgemat.desk && viewItem =~ /edgemat\\.deskEntry/",
          "group": "desk@3"
        }
      ],
      "commandPalette": [
        {
          "command": "edgemat.openMesh",
          "when": "false"
        },
        {
          "command": "edgemat.openMaterial",
          "when": "false"
        },
        {
          "command": "edgemat.copyGamePath",
          "when": "false"
        },
        {
          "command": "edgemat.copyCetCommand",
          "when": "false"
        },
        {
          "command": "edgemat.addToDesk",
          "when": "false"
        },
        {
          "command": "edgemat.openItem",
          "when": "false"
        },
        {
          "command": "edgemat.openFoundSetup",
          "when": "false"
        },
        {
          "command": "edgemat.clearFind",
          "when": "edgemat.findActive"
        },
        {
          "command": "edgemat.clearSearch",
          "when": "edgemat.filtered"
        },
        {
          "command": "edgemat.viewIn3D",
          "when": "false"
        },
        {
          "command": "edgemat.saveToProject",
          "when": "activeCustomEditorId == edgemat.setup"
        },
        {
          "command": "edgemat.newMaterialHere",
          "when": "false"
        },
        {
          "command": "edgemat.removeFromDesk",
          "when": "false"
        },
        {
          "command": "edgemat.deskEntryToProject",
          "when": "false"
        },
        {
          "command": "edgemat.renameDeskEntry",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "edgemat.openMesh",
          "when": "resourceExtname == .mesh",
          "group": "navigation@9"
        },
        {
          "command": "edgemat.openMaterial",
          "when": "resourceFilename =~ /\\.(mlsetup|mlsetup\\.json|mltemplate)$/i",
          "group": "navigation@9"
        }
      ],
      "editor/title/context": [
        {
          "command": "edgemat.openMesh",
          "when": "resourceExtname == .mesh",
          "group": "1_open@9"
        },
        {
          "command": "edgemat.openMaterial",
          "when": "resourceFilename =~ /\\.(mlsetup|mlsetup\\.json|mltemplate)$/i",
          "group": "1_open@9"
        }
      ],
      "editor/title": [
        {
          "command": "edgemat.saveToProject",
          "when": "activeCustomEditorId == edgemat.setup",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "title": "EDGEmat",
      "properties": {
        "edgemat.gamePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "The Cyberpunk 2077 folder (the one holding `bin`, `archive` and `r6`). Empty: use REDcode's game folder, then EDGEdeck's, then search the machine."
        },
        "edgemat.bridgePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "REDbridge.exe, or the folder holding it. Empty: use REDcode's `redcode.bridgePath`, then REDbridge on PATH. When REDcode is running with the same game, EDGEmat uses REDcode's bridge."
        },
        "edgemat.dotnetRoot": {
          "type": "string",
          "default": "",
          "markdownDescription": "DOTNET_ROOT for the bridge, when .NET 10 is installed per user. Empty: use REDcode's `redcode.dotnetRoot`."
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "edgemat.mcp",
        "label": "EDGEmat"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "node ../../tools/release/notes.mjs --extension && node esbuild.mjs && node ../../tools/release/notices.mjs --extension",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "tiling-check": "node scripts/tiling-check.mjs"
  },
  "dependencies": {
    "pngjs": "7.0.0",
    "vscode-jsonrpc": "^9.0.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/vscode": "1.70.0",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.3"
  }
}
